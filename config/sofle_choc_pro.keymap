#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

#define DAYZ 4
#define DAYZALT 5

#define ABI 6
#define ABIALT 7

#define WDOGS 8
#define WDOGSALT 9

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <dt-bindings/zmk/pointing.h>

/ {
  // Activate ADJUST layer by pressing raise and lower
  conditional_layers {
    compatible = "zmk,conditional-layers";
    adjust_layer {
      if-layers = <LOWER RAISE>;
      then-layer = <ADJUST>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "default";
      // ┌─────┬─────┬─────┬─────┬─────┬─────┬──────────────────┬─────┬─────┬─────┬─────┬─────┬─────┐
      // │ ESC │  1  │  2  │  3  │  4  │  5  │                  │  6  │  7  │  8  │  9  │  0  │ DEL │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ TAB │  Q  │  W  │  E  │  R  │  T  │                  │  Y  │  U  │  I  │  O  │  P  │ BSPC│
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ CTRL│  A  │  S  │  D  │  F  │  G  │                  │  H  │  J  │  K  │  L  │  ;  │  '  │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ SHFT│  Z  │  X  │  C  │  V  │  B  │    PLAY   MUTE   │  N  │  M  │  ,  │  .  │  /  │ SHFT│
      // └─────┴─────┴─────┴─────┴─────┴─────┴──────────────────┴─────┴─────┴─────┴─────┴─────┴─────┘
      // ┌─────┬─────┬─────┬─────┬─────┬──────────────────────────────┬─────┬─────┬─────┬─────┬─────┐
      // │     │ GUI │ ALT │LOWER│SPACE│                              │ENTER│RAISE│ ALT │ GUI │     │
      // └─────┴─────┴─────┴─────┴─────┴──────────────────────────────┴─────┴─────┴─────┴─────┴─────┘
      bindings = <
        &kp ESC   &kp N1 &kp N2  &kp N3 &kp N4 &kp N5                           &kp N6 &kp N7 &kp N8    &kp N9  &kp N0   &kp DEL
        &kp TAB   &kp Q  &kp W   &kp E  &kp R  &kp T                            &kp Y  &kp U  &kp I     &kp O   &kp P    &kp BSPC
        &kp LCTRL &kp A  &kp S   &kp D  &kp F  &kp G                            &kp H  &kp J  &kp K     &kp L   &kp SEMI &kp SQT
        &kp LSHFT &kp Z  &kp X   &kp C  &kp V  &kp B   &kp C_PLAY &kp C_MUTE    &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
          &none &kp LGUI &kp LALT &mo LOWER &kp SPACE      &kp RET &mo RAISE &kp RALT &kp RGUI &none
      >;

      sensor-bindings = <&inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
    };

    lower_layer {
      display-name = "lower";
      // ┌─────┬─────┬─────┬─────┬─────┬─────┬──────────────────┬─────┬─────┬─────┬─────┬─────┬─────┐
      // │ ··· │  F1 │  F2 │  F3 │  F4 │  F5 │                  │  F6 │  F7 │  F8 │  F9 │ F10 │ F11 │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ ··· │  1  │  2  │  3  │  4  │  5  │                  │  6  │  7  │  8  │  9  │  0  │ F12 │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ ··· │ ESC │     │     │     │     │                  │  ←  │  ↓  │  ↑  │  →  │     │RCTRL│
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ ··· │ CAPS│     │     │     │ RGB │     ···  ···     │ HOME│ PGDN│ PGUP│ END │     │RSHFT│
      // └─────┴─────┴─────┴─────┴─────┴─────┴──────────────────┴─────┴─────┴─────┴─────┴─────┴─────┘
      // ┌─────┬─────┬─────┬─────┬─────┬──────────────────────────────┬─────┬─────┬─────┬─────┬─────┐
      // │ ··· │ ··· │ ··· │ ··· │ ··· │                              │ ··· │ ··· │ ··· │ ··· │ ··· │
      // └─────┴─────┴─────┴─────┴─────┴──────────────────────────────┴─────┴─────┴─────┴─────┴─────┘
      // ··· = transparent (base layer key)
      bindings = <
        &trans   &kp F1   &kp F2 &kp F3 &kp F4 &kp F5                            &kp F6    &kp F7   &kp F8    &kp F9    &kp F10   &kp F11
        &trans   &kp N1   &kp N2 &kp N3 &kp N4 &kp N5                            &kp N6   &kp N7    &kp N8    &kp N9    &kp N0 &kp F12
        &trans   &kp ESC  &none  &none  &none  &none                             &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &none  &kp RCTRL
        &trans   &kp CAPS &none  &none  &none  &rgb_ug RGB_TOG &trans   &trans   &kp HOME &kp PG_DN &kp PG_UP &kp END   &none  &kp RSHFT
          &trans   &trans      &trans    &trans     &trans                         &trans  &trans    &trans   &trans    &trans
      >;

      sensor-bindings = <&inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
    };

    raise_layer {
      display-name = "raise";
      // ┌─────┬─────┬─────┬─────┬─────┬─────┬──────────────────┬─────┬─────┬─────┬─────┬─────┬─────┐
      // │ ··· │ ··· │ ··· │ ··· │ ··· │ ··· │                  │ ··· │ ··· │ ··· │ ··· │ ··· │ ··· │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ ··· │  !  │  @  │  #  │  $  │  %  │                  │  ^  │  &  │  *  │  (  │  )  │ DEL │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ ··· │ ESC │     │     │     │     │                  │  =  │  -  │  [  │  ]  │  \  │  `  │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ ··· │ CAPS│     │     │     │     │     ···  ···     │  +  │  _  │  {  │  }  │  |  │  ~  │
      // └─────┴─────┴─────┴─────┴─────┴─────┴──────────────────┴─────┴─────┴─────┴─────┴─────┴─────┘
      // ┌─────┬─────┬─────┬─────┬─────┬──────────────────────────────┬─────┬─────┬─────┬─────┬─────┐
      // │ ··· │ ··· │ ··· │ ··· │ ··· │                              │ ··· │ ··· │ ··· │ ··· │ ··· │
      // └─────┴─────┴─────┴─────┴─────┴──────────────────────────────┴─────┴─────┴─────┴─────┴─────┘
      // ··· = transparent (base layer key)
      bindings = <
        &trans    &trans    &trans    &trans     &trans     &trans                         &trans    &trans    &trans          &trans   &trans   &trans
        &trans    &kp EXCL  &kp AT    &kp HASH   &kp DOLLAR &kp PRCNT                      &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp DEL
        &trans    &kp ESC   &none     &none      &none      &none                          &kp EQUAL &kp MINUS &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
        &trans    &kp CAPS  &none     &none      &none      &none      &trans   &trans     &kp PLUS  &kp UNDER &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
          &trans       &trans       &trans       &trans          &trans                &trans    &trans    &trans    &trans    &trans
      >;

      sensor-bindings = <&inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
    };

    adjust_layer {
      // ┌─────┬─────┬─────┬─────┬─────┬─────┬──────────────────┬─────┬─────┬─────┬─────┬─────┬─────┐
      // │UNLCK│     │     │     │     │     │                  │DAYZ │AB:I │WDOGS│     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │     │     │     │     │     │     │                  │     │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ MB5 │ MB4 │ MB2 │ MB3 │ MB1 │     │                  │  m← │  m↓ │  m↑ │  m→ │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │BTCLR│  s← │  s↓ │  s↑ │  s→ │     │     ···  ···     │     │ BT0 │ BT1 │ BT2 │ BT3 │ BT4 │
      // └─────┴─────┴─────┴─────┴─────┴─────┴──────────────────┴─────┴─────┴─────┴─────┴─────┴─────┘
      // ┌─────┬─────┬─────┬─────┬─────┬──────────────────────────────┬─────┬─────┬─────┬─────┬─────┐
      // │ ··· │ ··· │ ··· │ ··· │ ··· │                              │ ··· │ ··· │ ··· │ ··· │ ··· │
      // └─────┴─────┴─────┴─────┴─────┴──────────────────────────────┴─────┴─────┴─────┴─────┴─────┘
      // UNLK = unlock Sofle Studio  ·  m = mouse move  ·  s = scroll  ·  ··· = transparent
      display-name = "adjust";
      bindings = <
        &studio_unlock &none          &none          &none        &none           &none                          &tog DAYZ       &tog ABI        &tog WDOGS    &none            &none   &none
        &none          &none          &none          &none        &none           &none                          &none           &none           &none         &none            &none   &none
        &mkp MB5       &mkp MB4       &mkp MB2       &mkp MB3     &mkp MB1        &none                          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none   &none
        &bt BT_CLR     &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT &none   &trans    &trans       &none           &none           &none         &none            &none   &none
         &trans       &trans       &trans       &trans          &trans                &trans    &trans    &trans    &trans    &trans
      >;
      sensor-bindings = <&inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
    };

    dayz_layer {
      display-name = "dayz";
      // ┌─────┬─────┬─────┬─────┬─────┬─────┬──────────────────┬─────┬─────┬─────┬─────┬─────┬─────┐
      // │ ESC │  1  │  2  │  3  │  4  │  5  │                  │     │     │     │     │     │DAYZ │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ TAB │     │  Q  │  W  │  E  │  R  │                  │     │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ SHFT│     │  A  │  S  │  D  │  F  │                  │     │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ CTRL│  B  │  X  │     │  C  │  G  │     ···  ···     │     │     │     │     │     │     │
      // └─────┴─────┴─────┴─────┴─────┴─────┴──────────────────┴─────┴─────┴─────┴─────┴─────┴─────┘
      // ┌─────┬─────┬─────┬─────┬─────┬──────────────────────────────┬─────┬─────┬─────┬─────┬─────┐
      // │     │     │     │DAYZ │SPACE│                              │     │     │     │     │     │
      // └─────┴─────┴─────┴─────┴─────┴──────────────────────────────┴─────┴─────┴─────┴─────┴─────┘
      bindings = <
        &kp ESC   &kp N1 &kp N2  &kp N3 &kp N4 &kp N5                           &none  &none  &none  &none  &none  &tog DAYZ
        &kp TAB   &none  &kp Q   &kp W  &kp E  &kp R                            &none  &none  &none  &none  &none  &none
        &kp LSHFT &none  &kp A  &kp S   &kp D  &kp F                            &none  &none  &none  &none  &none  &none
        &kp LCTRL &kp B  &kp X   &none  &kp C  &kp G     &trans     &trans      &none  &none  &none  &none  &none  &none
          &none  &none  &none  &mo DAYZALT &kp SPACE                                 &none  &none  &none  &none  &none
      >;
      sensor-bindings = <&inc_dec_kp PG_DN PG_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
    };
    
    dayz_alt_layer {
      display-name = "dayz alt";
      // ┌─────┬─────┬─────┬─────┬─────┬─────┬──────────────────┬─────┬─────┬─────┬─────┬─────┬─────┐
      // │ ESC │  6  │  7  │  8  │  9  │  0  │                  │     │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ TAB │     │  Q  │  W  │  E  │  T  │                  │     │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ SHFT│     │  A  │  S  │  D  │  F  │                  │     │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ CTRL│  B  │     │     │  C  │  G  │     ···  ···     │     │     │     │     │     │     │
      // └─────┴─────┴─────┴─────┴─────┴─────┴──────────────────┴─────┴─────┴─────┴─────┴─────┴─────┘
      // ┌─────┬─────┬─────┬─────┬─────┬──────────────────────────────┬─────┬─────┬─────┬─────┬─────┐
      // │LGUI │     │     │ ... │SPACE│                              │     │     │     │     │     │
      // └─────┴─────┴─────┴─────┴─────┴──────────────────────────────┴─────┴─────┴─────┴─────┴─────┘
      bindings = <
        &kp ESC   &kp N6 &kp N7  &kp N8 &kp N9 &kp N0                           &none  &none  &none  &none  &none  &none
        &kp TAB   &none  &kt Q   &kp W  &kt E  &kp T                            &none  &none  &none  &none  &none  &none
        &kp LSHFT &none  &kp A   &kp S  &kp D  &kp F                            &none  &none  &none  &none  &none  &none
        &kp LCTRL &kp B  &none   &none  &kp C  &kp G     &trans     &trans      &none  &none  &none  &none  &none  &none
          &kp LGUI  &none  &none  &trans &kp SPACE                                 &none  &none  &none  &none  &none
      >;
      sensor-bindings = <&inc_dec_kp PG_DN PG_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
    };

    abi_layer {
      display-name = "ab:i";
      // ┌─────┬─────┬─────┬─────┬─────┬─────┬──────────────────┬─────┬─────┬─────┬─────┬─────┬─────┐
      // │ ESC │  4  │  2  │  3  │  1  │  5  │                  │     │     │     │     │     │AB:I │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ TAB │     │  Q  │  W  │  E  │  R  │                  │     │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ SHFT│  V  │  A  │  S  │  D  │  F  │                  │     │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ CTRL│  B  │     │     │ Z|C │  G  │     ···  ···     │     │     │     │     │     │     │
      // └─────┴─────┴─────┴─────┴─────┴─────┴──────────────────┴─────┴─────┴─────┴─────┴─────┴─────┘
      // ┌─────┬─────┬─────┬─────┬─────┬──────────────────────────────┬─────┬─────┬─────┬─────┬─────┐
      // │     │     │     │AB:I │SPACE│                              │     │     │     │     │     │
      // └─────┴─────┴─────┴─────┴─────┴──────────────────────────────┴─────┴─────┴─────┴─────┴─────┘
      bindings = <
        &kp ESC   &kp N4 &kp N2  &kp N3 &kp N1  &kp N5                           &none  &none  &none  &none  &none  &tog ABI
        &kp TAB   &none  &kp Q   &kp W  &kp E   &kp R                            &none  &none  &none  &none  &none  &none
        &kp LSHFT &kp V  &kp A   &kp S  &kp D   &kp F                            &none  &none  &none  &none  &none  &none
        &kp LCTRL &kp B  &kp Z   &none  &mt Z C &kp G     &trans     &trans      &none  &none  &none  &none  &none  &none
          &none  &none  &none  &mo ABIALT &kp SPACE                                 &none  &none  &none  &none  &none
      >;
      sensor-bindings = <&inc_dec_kp PG_DN PG_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
    };
    
    abi_alt_layer {
      display-name = "ab:i alt";
      // ┌─────┬─────┬─────┬─────┬─────┬─────┬──────────────────┬─────┬─────┬─────┬─────┬─────┬─────┐
      // │ ESC │  6  │  7  │  8  │  9  │  0  │                  │     │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ TAB │     │  Q  │  W  │  E  │  T  │                  │     │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ SHFT│  V  │  A  │  S  │  D  │  F  │                  │     │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ CTRL│  B  │     │     │ Z|C │  N  │     ···  ···     │     │     │     │     │     │     │
      // └─────┴─────┴─────┴─────┴─────┴─────┴──────────────────┴─────┴─────┴─────┴─────┴─────┴─────┘
      // ┌─────┬─────┬─────┬─────┬─────┬──────────────────────────────┬─────┬─────┬─────┬─────┬─────┐
      // │LGUI │     │     │ ... │SPACE│                              │     │     │     │     │     │
      // └─────┴─────┴─────┴─────┴─────┴──────────────────────────────┴─────┴─────┴─────┴─────┴─────┘
      bindings = <
        &kp ESC   &kp N6 &kp N7  &kp N8 &kp N9  &kp N0                           &none  &none  &none  &none  &none  &none
        &kp TAB   &none  &kt Q   &kp W  &kt E   &kp T                            &none  &none  &none  &none  &none  &none
        &kp LSHFT &kp V  &kp A   &kp S  &kp D   &kp F                            &none  &none  &none  &none  &none  &none
        &kp LCTRL &kp B  &none   &none  &mt Z C &kp N     &trans     &trans      &none  &none  &none  &none  &none  &none
          &kp LGUI  &none  &none  &trans &kp SPACE                                 &none  &none  &none  &none  &none
      >;
      sensor-bindings = <&inc_dec_kp PG_DN PG_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
    };

    wdogs_layer {
      display-name = "wdogs";
      // ┌─────┬─────┬─────┬─────┬─────┬─────┬──────────────────┬─────┬─────┬─────┬─────┬─────┬─────┐
      // │ ESC │  1  │  2  │  3  │  4  │  5  │                  │     │     │     │     │     │WDOGS│
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ TAB │     │  Q  │  W  │  E  │  R  │                  │     │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ SHFT│     │  A  │  S  │  D  │  F  │                  │     │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ CTRL│  B  │  X  │     │  C  │  G  │     ···  ···     │     │     │     │     │     │     │
      // └─────┴─────┴─────┴─────┴─────┴─────┴──────────────────┴─────┴─────┴─────┴─────┴─────┴─────┘
      // ┌─────┬─────┬─────┬─────┬─────┬──────────────────────────────┬─────┬─────┬─────┬─────┬─────┐
      // │     │     │     │WDOGS│SPACE│                              │     │     │     │     │     │
      // └─────┴─────┴─────┴─────┴─────┴──────────────────────────────┴─────┴─────┴─────┴─────┴─────┘
      bindings = <
        &kp ESC   &kp N1 &kp N2  &kp N3 &kp N4 &kp N5                           &none  &none  &none  &none  &none  &tog WDOGS
        &kp TAB   &none  &kp Q   &kp W  &kp E  &kp R                            &none  &none  &none  &none  &none  &none
        &kp LSHFT &none  &kp A   &kp S  &kp D  &kp F                            &none  &none  &none  &none  &none  &none
        &kp LCTRL &kp B  &kp X   &none  &kp C  &kp G     &trans     &trans      &none  &none  &none  &none  &none  &none
          &none  &none  &none  &mo WDOGSALT &kp SPACE                                 &none  &none  &none  &none  &none
      >;
      sensor-bindings = <&inc_dec_kp PG_DN PG_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
    };
    
    wdogs_alt_layer {
      display-name = "wdogs alt";
      // ┌─────┬─────┬─────┬─────┬─────┬─────┬──────────────────┬─────┬─────┬─────┬─────┬─────┬─────┐
      // │ ESC │  6  │  7  │  8  │  9  │  0  │                  │     │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ TAB │     │  Q  │  W  │  E  │  T  │                  │     │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ SHFT│     │  A  │  S  │  D  │  F  │                  │     │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┼─────┼──────────────────┼─────┼─────┼─────┼─────┼─────┼─────┤
      // │ CTRL│  B  │  X  │     │  C  │  G  │     ···  ···     │     │     │     │     │     │     │
      // └─────┴─────┴─────┴─────┴─────┴─────┴──────────────────┴─────┴─────┴─────┴─────┴─────┴─────┘
      // ┌─────┬─────┬─────┬─────┬─────┬──────────────────────────────┬─────┬─────┬─────┬─────┬─────┐
      // │LGUI │     │     │ ... │SPACE│                              │     │     │     │     │     │
      // └─────┴─────┴─────┴─────┴─────┴──────────────────────────────┴─────┴─────┴─────┴─────┴─────┘
      bindings = <
        &kp ESC   &kp N6 &kp N7  &kp N8 &kp N9 &kp N0                           &none  &none  &none  &none  &none  &none
        &kp TAB   &none  &kt Q   &kp W  &kt E  &kp T                            &none  &none  &none  &none  &none  &none
        &kp LSHFT &none  &kp A   &kp S  &kp D  &kp F                            &none  &none  &none  &none  &none  &none
        &kp LCTRL &kp B  &kp X   &none  &kp C  &kp G     &trans     &trans      &none  &none  &none  &none  &none  &none
          &kp LGUI  &none  &none  &trans &kp SPACE                                 &none  &none  &none  &none  &none
      >;
      sensor-bindings = <&inc_dec_kp PG_DN PG_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
    };
  };
};
